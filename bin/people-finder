#!/usr/bin/env python3
"""people-finder launcher.

Resolves the bundled zero-dependency core relative to this file, so the CLI
behaves identically from any working directory.
"""

import os
import sys

HERE = os.path.dirname(os.path.realpath(os.path.abspath(__file__)))
SRC = os.path.join(os.path.dirname(HERE), "src")
if SRC not in sys.path:
    sys.path.insert(0, SRC)

from people_finder.cli import main  # noqa: E402  (path set up above)

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
